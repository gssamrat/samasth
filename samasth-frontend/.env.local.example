# Local Environment Variables Override Example
# Copy this file to .env.local to override development defaults
# .env.local is ignored by git for security

# Override API Base URL for local development
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Or point to a remote development server
# VITE_API_BASE_URL=https://dev-api.yourdomain.com/api/v1
